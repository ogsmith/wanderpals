# --- Provisioned by Vercel Marketplace (run `vercel env pull` to fill these in) ---
# Clerk (sign-in)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Neon (Postgres)
DATABASE_URL=

# --- Add yourself (locally in .env.local, and in Vercel → Project → Settings → Environment Variables) ---
# Claude: photo-to-avatar, personality read, match ranking. Without it, rule-based fallbacks are used.
ANTHROPIC_API_KEY=
# Only needed if your API key is not scoped to a workspace (Console → Settings → Workspaces).
ANTHROPIC_WORKSPACE_ID=
# Google Maps (Places API (New) + Geocoding API): city search + "use my location". Optional; falls back to a built-in city list.
GOOGLE_MAPS_API_KEY=

# 32 random bytes, base64 — encrypts stored calendar links
CALENDAR_KEY=
